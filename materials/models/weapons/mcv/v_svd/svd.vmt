"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_svd\svd_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_svd\svd_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_svd\svd_exponent"

	"$phong" "1"
	"$phongboost"	".8"
	"$phongfresnelranges"	"[1 2 4]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "40"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .07 .07 .07]"
	"$normalmapalphaenvmapmask" "1"

	// "$rimlight" "1"
	// "$rimlightexponent" "6"
	// "$rimlightboost" "0.4"
	// "$rimmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


