"VertexLitGeneric"
{
	"$phong" "1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[1 1.5 2]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "20"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .03 .03 .03]"
	"$normalmapalphaenvmapmask" "1"
	
	// "$rimlight" "1"
	// "$rimlightexponent" "4"
	// "$rimlightboost" "0.3"
	// "$rimmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
