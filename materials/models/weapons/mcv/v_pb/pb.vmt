"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_pb\pb_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_pb\pb_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_pb\pb_exponent"
	
	"$phong" "1"
	"$phongboost"	"1.8"
	"$phongfresnelranges"	"[1 3 5]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "20"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .05 .05 .05]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "0.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


