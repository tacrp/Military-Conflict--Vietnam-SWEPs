"VertexLitGeneric"
{
    "$basetexture"						"models\weapons\mcv\v_reising\m60r_diffuse"
    "$bumpmap"							"models\weapons\mcv\v_reising\m60r_normal"
	"$PhongExponentTexture"				"models\weapons\mcv\v_reising\m60r_exponent"

	"$phong" "1"
	"$phongboost"	".4"
	"$phongfresnelranges"	"[1 2 4]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "15"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .08 .08 .08]"
	"$normalmapalphaenvmapmask" "1"

	
	// "$rimlight" "1"
	// "$rimlightexponent" "15"
	// "$rimlightboost" "0.6"
	// "$rimmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}

