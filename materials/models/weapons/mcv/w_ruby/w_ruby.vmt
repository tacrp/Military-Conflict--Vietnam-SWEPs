"VertexLitGeneric"
{
	"$basetexture"					"models\weapons\mcv\w_ruby\w_ruby_diffuse"
    "$bumpmap"						"models\weapons\mcv\w_ruby\w_ruby_normal"
	"$PhongExponentTexture"			"models\weapons\mcv\w_ruby\w_ruby_exponent"

	"$phong" "1"
	"$phongboost"	"1"
//	"$PhongExponent" "80"
	"$phongfresnelranges"	"[1 2 2]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "24"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .12 .12 .12]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "0.35"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
