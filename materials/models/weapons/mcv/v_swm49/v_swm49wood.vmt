"VertexLitGeneric"
{
	"$basetexture"						"models\weapons\mcv\v_swm49\v_swm49wood_diffuse"
    "$bumpmap"							"models\weapons\mcv\v_swm49\v_swm49wood_normal"
	"$PhongExponentTexture"				"models\weapons\mcv\v_swm49\v_swm49wood_exponent"

	"$phong" "1"
	"$phongboost"	"1"
//	"$PhongExponent" "80"
	"$phongfresnelranges"	"[1 2 4]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "25"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .12 .12 .12]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "0.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
