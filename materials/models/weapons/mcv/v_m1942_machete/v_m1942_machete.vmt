"VertexLitGeneric"
{
	"$basetexture"                    	"models\weapons\mcv\v_m1942_machete\v_m1942_machete_diffuse"
    "$bumpmap"                         	"models\weapons\mcv\v_m1942_machete\v_m1942_machete_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_m1942_machete\v_m1942_machete_exponent"

	"$phong" "1"
	"$phongboost"	"4"
	"$phongfresnelranges"	"[1 1.3 2]"
	"$phongalbedotint" "1"
	"$phongalbedoboost" "15"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .15 .15 .15]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "[0.5 0.5]"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


