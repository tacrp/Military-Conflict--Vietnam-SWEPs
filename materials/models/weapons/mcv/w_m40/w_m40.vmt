"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\w_m40\w_m40_diffuse"
    "$bumpmap"                         "models\weapons\mcv\w_m40\w_m40_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\w_m40\w_m40_exponent"

	"$phong" "1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[1 3 4]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "25"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .05 .05 .05]"
	"$normalmapalphaenvmapmask" "1"

	
	// "$rimlight" "1"
	// "$rimlightexponent" "4"
	// "$rimlightboost" "0.8"
	// "$rimmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
