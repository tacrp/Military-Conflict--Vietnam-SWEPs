{
	"$basetexture" 				"models\weapons\mcv\w_m7188\w_m7188_diffuse"
	"$bumpmap" 					"models\weapons\mcv\w_m7188\w_m7188_normal"
	"$PhongExponentTexture" 	"models\weapons\mcv\w_m7188\w_m7188_exponent"

	"$phong"					"1"
	"$phongboost"				"0.6"
	"$phongfresnelranges"		"[1 1.2 4]"
	"$PhongAlbedoTint"			"1"
	"$phongalbedoboost"			"10"
	"$surfaceprop"				"metal"
	
	"$envmap"					"env_cubemap"
	"$envmaptint"				"[ .07 .07 .07]"
	"$normalmapalphaenvmapmask"	"1"
	
	//"$rimlight"					"1"
	//"$rimlightexponent"			"4"
	//"$rimlightboost"			"0.5"
	//"$rimmask"					"1"
