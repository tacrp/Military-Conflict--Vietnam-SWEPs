	//"$alphatest"				"1"

	"$detail"					"models/effects/dynamic_detail"
	"$detailscale"				"1.50"
	"$detailblendfactor"		"0.0"
	"$detailblendmode"			"0"
	"$detailframe"				"0"

	"$alphatest" 1
	"$alphatocoverage_userdriven" "1" // Follows "Alpha Smoothing" in-game setting, use original $AllowAlphaToCoverage to force it.

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
