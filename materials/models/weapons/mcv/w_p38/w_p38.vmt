"VertexLitGeneric"
{
    "$basetexture"                    "models\weapons\mcv\w_p38\w_p38_diffuse"
    "$bumpmap"                         "models\weapons\mcv\w_p38\w_p38_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\w_p38\w_p38_exponent"

	"$phong" "1"
	"$phongboost"	"0.2"
	"$phongfresnelranges"	"[1 2 3]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "1"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .06 .06 .06]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "0.5"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


