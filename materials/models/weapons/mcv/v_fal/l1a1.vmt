"VertexLitGeneric"
{
	"$basetexture"						"models\weapons\mcv\v_fal\l1a1_diffuse"
    "$bumpmap"							"models\weapons\mcv\v_fal\l1a1_normal"
	"$PhongExponentTexture"				"models\weapons\mcv\v_fal\l1a1_exponent"

	"$phong" "1"
	"$phongboost"	".2"
	"$phongfresnelranges"	"[1 2 4]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "20"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .07 .07 .07]"
	"$normalmapalphaenvmapmask" "1"

	"$rimlight" "1"
	"$rimlightexponent" "6"
	"$rimlightboost" "0.15"
	"$rimmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


