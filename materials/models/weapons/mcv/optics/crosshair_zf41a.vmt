//VertexLitGeneric"
//
//	"$basetexture" "models\weapons\mcv\optics\crosshair_zf41"
//	"$translucent" 1
//	"$nocsm" "1"
//



"Refract"
{
	"$basetexture" "_rt_SniperScope"
	"$normalmap" "models\weapons\mcv\optics\scope_glass_normal"

 	"$model" "1"

	"$scopelensmode" "1" 	// Mode used for scope lens effect on sniper rifles. 
				// Multiplies RefractSampler by refract tint alpha and uses model's UV to read RefractSampler instead of screen coordinates
	
	"$refracttransform" "center 0.5 0.5 scale 0.01 0.01 rotate 0.0 translate 0.0 0.0"
 	"$refractamount" "0.5"	// normalmap strength

 	"$surfaceprop" "glass"

	"$envmap" "env_cubemap"
	"$envmaptint" "[0.675 0.675 0.675]"
	"$envmapfresnel" "1"
	
	// DX10+ smooth cubemap transitions - should only be used on viewmodels
	"$cubemapblend"	"1"

	"$REFRACTTINTTEXTURE" "models\weapons\mcv\optics\crosshair_zf41b"

	"$subsurface_scattering" "1"
    "$sssscale" "1.0"
   	"$ssspower" "8.0"
   	"$sssatten" "0.25"
   	"$sssdistortion" "0.5"
   	"$sssthickness" "0.5" // actually, reversed. Higher value - less thick
   	"$ssscolortint" "[1 1 1]"
	
	// for ssao depth rendering hacks, do not modify or delete these lines
	"$opaque_mode"	"1"
	"$override_depth_texture" "_rt_FullFrameDepth"

	"Proxies"
	{
               "ScopeLensToggle"
		{
			"resultVar" "$refracttint"
		}
		"ScopeTintTransition"
		{
			"tintvar" "$envmaptint"
			"tint_inscope" "0.1 0.1 0.1"
		}
	}
}
