"VertexLitGeneric"
{
	"$basetexture" 	"models\weapons\mcv\v_m870\m870_diffuse"
	"$bumpmap" 		"models\weapons\mcv\v_m870\m870_normal"
	"$PhongExponentTexture" "models\weapons\mcv\v_m870\m870_exponent"

	"$phong" "1"
	"$phongboost"	".2"
	"$phongfresnelranges"	"[0.6 1 1.5]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "15"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .1 .1 .1]"
	"$normalmapalphaenvmapmask" "1"
	
	"$rimlight" "0"
	"$rimlightexponent" "2"
	"$rimlightboost" "0.2"
	"$rimmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
