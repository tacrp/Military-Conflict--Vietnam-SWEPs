"VertexLitGeneric"
{
	"$basetexture" 	"models\weapons\mcv\v_m870\stock_diffuse"
	"$bumpmap" 		"models\weapons\mcv\v_m870\stock_normal"
	"$PhongExponentTexture" "models\weapons\mcv\v_m870\stock_exponent"

	"$phong" "1"
	"$phongboost"	".5"
	"$phongfresnelranges"	"[0.8 1 2]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "35"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .1 .1 .1]"
	"$normalmapalphaenvmapmask" "1"
	
	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" "0.2"
	"$rimmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
