"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_ppsh41\ppsh41_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_ppsh41\ppsh41_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_ppsh41\ppsh41_exponent"

	"$phong" "1"
	"$phongboost"	".5"
	"$phongfresnelranges"	"[1 3 5]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "6"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .08 .08 .08]"
	"$normalmapalphaenvmapmask" "1"

	"$rimlight" "1"
	"$rimlightexponent" "15"
	"$rimlightboost" "0.2"
	"$rimmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


