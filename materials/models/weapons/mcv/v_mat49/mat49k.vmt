"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_mat49\mat49k_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_mat49\mat49k_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_mat49\mat49_exponent"
	
	"$phong" "1"
	"$phongboost"	".1"
	"$phongfresnelranges"	"[0.8 1 1.5]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "20"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .07 .07 .07]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}