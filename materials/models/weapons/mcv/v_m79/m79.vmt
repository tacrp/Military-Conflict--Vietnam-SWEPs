"VertexLitGeneric"
{
	"$basetexture"					"models\weapons\mcv\v_m79\m79_diffuse"
    "$bumpmap"						"models\weapons\mcv\v_m79\m79_normal"
	"$PhongExponentTexture"			"models\weapons\mcv\v_m79\m79_exponent"

	"$phong" "1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[0.7 1 2]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "12"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .06 .06 .06]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "0.5"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


