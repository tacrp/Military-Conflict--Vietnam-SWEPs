"VertexLitGeneric"
{
	"$basetexture"				"models\weapons\mcv\v_mk2\v_mk2_diffuse"
    "$bumpmap"					"models\weapons\mcv\v_mk2\v_mk2_normal"
	"$PhongExponentTexture"		"models\weapons\mcv\v_mk2\v_mk2_exponent"

	"$phong" "1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[1 1 2]"
	"$PhongAlbedoTint" "1"
	"$PhongAlbedoBoost" "20"
	"$surfaceprop" "weapon"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .16 .16 .16]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
