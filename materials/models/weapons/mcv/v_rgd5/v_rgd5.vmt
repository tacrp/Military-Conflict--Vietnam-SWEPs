"VertexLitGeneric"
{
	"$basetexture"			"models\weapons\mcv\v_rgd5\v_rgd5_diffuse"
    "$bumpmap"				"models\weapons\mcv\v_rgd5\v_rgd5_normal"
	"$PhongExponentTexture"	"models\weapons\mcv\v_rgd5\v_rgd5_exponent"

	"$phong" "1"
	"$phongboost"	".6"
	"$phongfresnelranges"	"[1.7 4 6]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "8"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .07 .07 .07]"
	"$normalmapalphaenvmapmask" "1"
//	"$envmapfresnel" "0.05"
	
	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" "0.15"
	"$rimmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}

