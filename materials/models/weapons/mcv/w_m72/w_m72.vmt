"VertexLitGeneric"
{
	"$basetexture"						"models\weapons\mcv\w_m72\w_m72_diffuse"
    "$bumpmap"							"models\weapons\mcv\w_m72\w_m72_normal"
	"$PhongExponentTexture"				"models\weapons\mcv\w_m72\w_m72_exponent"
	
	"$alphatest" "1"
	
	"$phong" "1"
	"$phongboost"	"1.5"
	"$phongfresnelranges"	"[0.8 1 1]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "20"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .24 .24 .24]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
