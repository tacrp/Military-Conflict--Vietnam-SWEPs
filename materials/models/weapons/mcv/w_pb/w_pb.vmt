"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\w_pb\w_pb_diffuse"
    "$bumpmap"                         "models\weapons\mcv\w_pb\w_pb_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\w_pb\w_pb_exponent"
	
	"$phong" "1"
	"$phongboost"	"0.8"
	"$phongfresnelranges"	"[1 3 5]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "10"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .03 .03 .03]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "0.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


