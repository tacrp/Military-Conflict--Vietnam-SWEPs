"VertexLitGeneric"
{
	"$basetexture"						"models\weapons\mcv\w_g3\w_g3_diffuse"
    "$bumpmap"							"models\weapons\mcv\w_g3\w_g3_normal"
	"$PhongExponentTexture"				"models\weapons\mcv\w_g3\w_g3_exponent"
	
	"$phong" "1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[1 1.4 2]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "26"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[.4 .4 .4]"
	"$normalmapalphaenvmapmask" "1"
	"$envmapalbedotintmultiply" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
