"VertexLitGeneric"
{
    "$basetexture"	"models\weapons\mcv\v_binocular\binoculars_diffuse"
    "$bumpmap"	"models\weapons\mcv\v_binocular\binoculars_normal"

	"$phong" "1"
	"$phongboost"	"3"
	"$phongfresnelranges"	"[0.08 2 4]"
	"$PhongAlbedoTint" "1"
	"$PhongTint" "[.9 1 .8]"
	"$PhongExponent" "130"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[.4 .5 .4]"
	"$normalmapalphaenvmapmask" "1"
	"$envmapfresnel" "1.3"
	
	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "2.00"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}