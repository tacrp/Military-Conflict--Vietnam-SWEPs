"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_c96\shanxi_type17_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_c96\shanxi_type17_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_c96\mauser96_exponent"

	"$phong" "1"
	"$phongboost"	"0.4"
	"$phongfresnelranges"	"[1 2 3]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "4"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .25 .25 .25]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "0.5"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


