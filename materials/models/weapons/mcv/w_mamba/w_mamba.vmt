"VertexLitGeneric"
{
    "$basetexture"					"models\weapons\mcv\w_mamba\w_mamba_diffuse"
    "$bumpmap"						"models\weapons\mcv\w_mamba\w_mamba_normal"
	"$PhongExponentTexture"			"models\weapons\mcv\w_mamba\w_mamba_exponent"


	"$phong" "1"
	"$phongboost"	"0.3"
	"$phongfresnelranges"	"[1 2 3]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "10"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .23 .23 .23]"
	"$normalmapalphaenvmapmask" "1"
	"$envmapsaturation" "0.3"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "0.5"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}

