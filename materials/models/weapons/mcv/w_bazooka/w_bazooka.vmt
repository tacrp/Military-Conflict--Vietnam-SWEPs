"VertexLitGeneric"
{
	"$basetexture"					"models\weapons\mcv\w_bazooka\w_bazooka_diffuse"
    "$bumpmap"						"models\weapons\mcv\w_bazooka\w_bazooka_normal"
	"$PhongExponentTexture"			"models\weapons\mcv\w_bazooka\w_bazooka_exponent"

	"$phong" "1"
	"$phongboost"	".3"
	"$phongfresnelranges"	"[0.5 1 1.75]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "15"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .1 .1 .1]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


