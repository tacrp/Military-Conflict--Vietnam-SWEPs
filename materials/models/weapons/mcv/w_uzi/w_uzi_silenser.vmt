"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\w_uzi\w_uzi_silenser_diffuse"
    "$bumpmap"                         "models\weapons\mcv\w_uzi\w_uzi_silenser_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\w_uzi\w_uzi_silenser_exponent"
	
	"$phong" "1"
	"$phongboost"	".4"
	"$phongfresnelranges"	"[1 2.5 3]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost"	"2"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .08 .08 .08]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.0"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


