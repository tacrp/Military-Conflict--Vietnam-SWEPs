"VertexLitGeneric"
{	
	"$basetexture"						"models\weapons\mcv\v_f1\f1_diffuse"
    "$bumpmap"							"models\weapons\mcv\v_f1\f1_normal"
	"$PhongExponentTexture"				"models\weapons\mcv\v_f1\f1_exponent"

	"$phong" "1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[1 1.4 2]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "20"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[.3 .3 .3]"
	"$normalmapalphaenvmapmask" "1"
	"$envmapalbedotintmultiply" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
