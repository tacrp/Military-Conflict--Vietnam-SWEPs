"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_m202\m202_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_m202\m202_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_m202\m202_exponent"

	"$phong" "1"
	"$phongboost"	".45"
	"$phongfresnelranges"	"[0.5 1 1.75]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "15"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .12 .12 .12]"
	"$normalmapalphaenvmapmask" "1"

	//"$rimlight" "1"
	//"$rimlightexponent" "2"
	//"$rimlightboost" "0.05"
	//"$rimmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


