"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_mp40\mp40_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_mp40\mp40_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_mp40\mp40_exponent"
	
	"$phong" "1"
	"$phongboost"	".7"
	"$phongfresnelranges"	"[1 1.5 2]"
	"$PhongAlbedoTint" "1"
	"$PhongAlbedoBoost" "10"
	"$surfaceprop" "metal"
	
	"$envmap" "env_cubemap"
	"$envmaptint" "[ .12 .12 .12]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}

