"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_kar98_s\german_riflegrenade_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_kar98_s\german_riflegrenade_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_kar98_s\german_riflegrenade_exponent"

	"$phong" "1"
	"$phongboost"	".7"
	"$phongfresnelranges"	"[1 1.25 1.5]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost"	"20"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .2 .2 .2]"
	"$normalmapalphaenvmapmask" "1"

	
	"$rimlight" "0"
	"$rimlightexponent" "15"
	"$rimlightboost" "0.3"
	"$rimmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}

