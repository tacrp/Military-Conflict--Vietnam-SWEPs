"VertexLitGeneric"
{
	"$baseTexture" 		"models\weapons\mcv\v_hand\v_hands_female_diffuse"
	"$bumpmap" 		"models\weapons\mcv\v_hand\v_hands_female_normal"
	"$phongexponenttexture"	"models\weapons\mcv\v_hand\v_hands_light_exponent"
	
	"$notint" "1"
	
	"$detail" "models/effects/dynamic_detail_hands"
	"$detailscale" "1.0"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"
	
	// "$envmap" "env_cubemap"
	// "$envmaptint" "[ .05 .05 .05]"
	// "$normalmapalphaenvmapmask" "1"
	
	"$phong"	"1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[0.05 1 2.5]"
	
	"$lightwarptexture" "models\weapons\mcv\v_hand\light_wrp"
	
	"Proxies"
	{
		"DynamicDetail"
		{
			"frameVar" "$detailframe"
			"blendVar" "$detailblendfactor"
		}
	}
}
