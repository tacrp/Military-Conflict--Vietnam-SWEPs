"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_m1911\m1911_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_m1911\m1911_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_m1911\m1911_exponent"

	"$phong" "1"
	"$phongboost"	"0.1"
//	"$PhongExponent" "80"
	"$phongfresnelranges"	"[1 2 4]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "30"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .22 .22 .22]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "0.40"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
