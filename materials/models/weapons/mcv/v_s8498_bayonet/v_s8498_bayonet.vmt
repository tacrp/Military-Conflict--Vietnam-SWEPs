"VertexLitGeneric"
{
	"$basetexture" 			"models\weapons\mcv\v_s8498_bayonet\v_s8498_bayonet_diffuse"
	"$bumpmap" 				"models\weapons\mcv\v_s8498_bayonet\v_s8498_bayonet_normal"
	"$PhongExponentTexture" "models\weapons\mcv\v_s8498_bayonet\v_s8498_bayonet_exponent"

	"$phong" "1"
	"$phongboost"	".8"
	"$phongfresnelranges"	"[1 1.2 3]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "15"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .34 .34 .34]"
	"$normalmapalphaenvmapmask" "1"

	
	"$rimlight" "0"
	"$rimlightexponent" "20"
	"$rimlightboost" "0.5"
	"$rimmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "[0.9 1.0]"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
