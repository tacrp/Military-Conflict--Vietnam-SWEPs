 "VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\w_svt40_s\w_svt40_s_diffuse"
    "$bumpmap"                         "models\weapons\mcv\w_svt40_s\w_svt40_s_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\w_svt40_s\w_svt40_s_exponent"

	"$phong" "1"
	"$phongboost"	".3"
	"$phongfresnelranges"	"[1 2 4]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost"	"15"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .2 .2 .2]"
	"$normalmapalphaenvmapmask" "1"

	"$rimlight" "1"
	"$rimlightexponent" "6"
	"$rimlightboost" "0.8"
	"$rimmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}