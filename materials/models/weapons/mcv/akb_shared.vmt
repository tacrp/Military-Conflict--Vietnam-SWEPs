	"$envmap" "env_cubemap"
	"$envmaptint" "[ .14 .14 .14]"
	"$normalmapalphaenvmapmask" "1"

	
	"$rimlight" "1"
	"$rimlightexponent" "20"
	"$rimlightboost" "0.5"
	"$rimmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "[0.9 1.0]"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
