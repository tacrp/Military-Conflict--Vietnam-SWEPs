"VertexLitGeneric"
{	
	"$basetexture"                    "models\weapons\mcv\v_dp28\dp28_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_dp28\dp28_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_dp28\dp28_exponent"

	"$phong" "1"
	"$phongboost"	".6"
	"$phongfresnelranges"	"[1 1.2 4]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "8"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .06 .06 .06]"
	"$normalmapalphaenvmapmask" "1"
	
	// "$rimlight" "1"
	// "$rimlightexponent" "4"
	// "$rimlightboost" "0.5"
	// "$rimmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
