"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_pps43\pps43_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_pps43\pps43_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_pps43\pps43_exponent"

	"$phong" "1"
	"$phongboost"	"5"
	"$phongfresnelranges"	"[1 3 5]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "25"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .23 .23 .23]"
	"$normalmapalphaenvmapmask" "1"

	"$rimlight" "0"
	"$rimlightexponent" "15"
	"$rimlightboost" "0.8"
	"$rimmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
