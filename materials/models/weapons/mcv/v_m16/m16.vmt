"VertexLitGeneric"
{
    "$basetexture"                    "models\weapons\mcv\v_m16\m16_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_m16\m16_normal"
	"$envmapmask"                        "models\weapons\mcv\v_m16\m16_specular"

	"$envmap" "env_cubemap" 
	"$envmaptint" "[.05 0.05 .05]" 
	"$phong" "1" 
	"$phongtint" "[1 1 1]" 
	"$phongexponent" 33
	"$phongboost" "1"  
	
	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "2.00"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}