"VertexLitGeneric"
{
	"$basetexture"				"models\weapons\mcv\v_css\css_white_diffuse"
    "$bumpmap"					"models\weapons\mcv\v_css\css_normal"
	"$PhongExponentTexture"		"models\weapons\mcv\v_css\css_exponent"

	"$phong" "1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[1 3 3]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "15"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .03 .03 .03]"
	"$normalmapalphaenvmapmask" "1"
//	"$envmapfresnel" "0.05"
	
	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" "1"
	"$rimmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
