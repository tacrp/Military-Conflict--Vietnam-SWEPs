"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\w_m3a1\w_m3a1_diffuse"
    "$bumpmap"                         "models\weapons\mcv\w_m3a1\w_m3a1_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\w_m3a1\w_m3a1_exponent"

	"$phong" "1"
	"$phongboost"	".6"
	"$phongfresnelranges"	"[0.7 1 2]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "35"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .18 .18 .18]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}

