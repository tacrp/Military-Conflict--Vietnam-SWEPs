"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_k50m\k50m_vc_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_k50m\k50m_vc_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_k50m\k50m_vc_exponent"
	
	"$phong" "1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[1 3 5]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "15"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .12 .12 .12]"
	"$normalmapalphaenvmapmask" "1"

	"$rimlight" "1"
	"$rimlightexponent" "15"
	"$rimlightboost" "0.1"
	"$rimmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}


