"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\w_m1g_s\w_m1g_s_diffuse"
    "$bumpmap"                         "models\weapons\mcv\w_m1g_s\w_m1g_s_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\w_m1g_s\w_m1g_s_exponent"

	"$phong" "1"
	"$phongboost"	".75"
	"$phongfresnelranges"	"[1 2 4]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "35"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .12 .12 .12]"
	"$normalmapalphaenvmapmask" "1"

	
	// "$rimlight" "1"
	// "$rimlightexponent" "15"
	// "$rimlightboost" "0.6"
	// "$rimmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}

