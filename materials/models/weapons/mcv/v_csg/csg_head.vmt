"VertexLitGeneric"
{
	"$basetexture"			"models\weapons\mcv\v_csg\csg_head_diffuse"
    "$bumpmap"				"models\weapons\mcv\v_csg\csg_head_normal"
	"$PhongExponentTexture"	"models\weapons\mcv\v_csg\csg_head_exponent"

	"$phong" "1"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[1 2 4]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "25"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .08 .08 .04]"
	"$normalmapalphaenvmapmask" "1"
//	"$envmapfresnel" "0.05"
	
	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" ".4"
	"$rimmask" "1"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
