"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\v_sten\sten_diffuse"
    "$bumpmap"                         "models\weapons\mcv\v_sten\sten_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\v_sten\sten_exponent"
	
	"$phong" "1"
	"$phongboost"	".7"
	"$phongfresnelranges"	"[1 2 2]"
	"$PhongAlbedoTint" "1"
	"$PhongAlbedoBoost" "08"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .15 .15 .15]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
