"VertexLitGeneric"
{
	"$phong" "1"
	"$phongboost"	".5"
	"$phongfresnelranges"	"[1 2 3]"
	"$PhongAlbedoTint" "1"
	"$phongalbedoboost" "15"
	"$surfaceprop" "metal"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .07 .07 .07]"
	"$normalmapalphaenvmapmask" "1"
//	"$envmapfresnel" "0.05"

	"$detail" "models/weapons/mcv/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}

