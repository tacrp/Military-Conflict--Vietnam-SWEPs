"VertexLitGeneric"
{
	"$basetexture" 	"models\weapons\mcv\v_molotov\molotov_mat_diffuse"
    "$bumpmap"      "models\weapons\mcv\v_molotov\molotov_mat_normal"
//	"$PhongExponentTexture" 			"models\weapons\mcv\v_molotov\molotov_mat_exponent"
	"$translucent" "1"
	"$surfaceprop" "glass"
//	"$nocull" "1"
	"$phong" "1"
	"$phongboost"	"2.5"
	"$phongfresnelranges"	"[0.3 6 8]"
	// "$PhongAlbedoTint" "1"
//	"$PhongTint" "[.3 .4 .3]"
	"$PhongExponent" "15"
	
	"$envmap" "env_cubemap"
	"$normalmapalphaenvmapmask" "1"
	"$envmaptint" "[.7 .8 .7]"
	"$envmapfresnel" "0.7"
	"$rimlight" "1"
	"$rimlightexponent" "8"
	"$rimlightboost" "5"
	
	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.75"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"
	
	"Proxies"
	{
		"DynamicDetail"
		{
			"frameVar" "$detailframe"
			"blendVar" "$detailblendfactor"
		}
	}
}