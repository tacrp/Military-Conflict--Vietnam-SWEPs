"VertexLitGeneric"
{
	"$basetexture"                    "models\weapons\mcv\rif_gl\w_rifle_grenades_vc_diffuse"
    "$bumpmap"                         "models\weapons\mcv\rif_gl\w_rifle_grenades_vc_normal"
	"$PhongExponentTexture" 			"models\weapons\mcv\rif_gl\w_rifle_grenades_vc_exponent"


	"$phong" "1"
	"$phongboost"	".35"
	"$phongfresnelranges"	"[1 1 2]"
	"$PhongAlbedoTint" "1"
	"$PhongAlbedoBoost" "8"
	"$surfaceprop" "weapon"

	"$envmap" "env_cubemap"
	"$envmaptint" "[ .16 .16 .16]"
	"$normalmapalphaenvmapmask" "1"

	"$detail" "models/effects/dynamic_detail"
	"$detailscale" "1.50"
	"$detailblendfactor" "0.0"
	"$detailblendmode" "0"
	"$detailframe" "0"

	"Proxies"	
	{
		"DynamicDetail"
		{
			"frameVar" "$detailFrame"
			"blendVar" "$detailblendfactor"
		}
	}
}
