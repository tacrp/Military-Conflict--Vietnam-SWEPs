"Refract"
{
//	$bumpmap "effects/Vietnam/Vietnam_AE_Muzzleflash_CineSmoke_Distort"
// 	$normalmap "effects/Vietnam/Vietnam_AE_Muzzleflash_CineSmoke_Distort"
	$bumpmap "effects/Vietnam/Vietnam_AE_Muzzleflash_CineSmoke_Distort_4"
 	$normalmap "effects/Vietnam/Vietnam_AE_Muzzleflash_CineSmoke_Distort_4"
 	$vertexalpha "1"
 	$vertexcolor "1"
 	$translucent "1"
	$vertexcolormodulate "1"
 	$forcerefract "1"
 	$bluramount "0.3"
	$refractamount "-.015"
