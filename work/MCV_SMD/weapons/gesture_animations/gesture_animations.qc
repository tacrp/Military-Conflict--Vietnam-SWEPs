	fps 30
	
	
}

$animation "gesturefingerpoint_01" "gesture_animations_anims\gesturefingerpoint_01.smd" {
	fps 30
	loop
	
	weightlist "weights_gesture01_fingerpoint"
}

$animation "gesturefingerpoint_run_01" "gesture_animations_anims\gesturefingerpoint_run_01.smd" {
	fps 30
	
	weightlist "weights_gesture01_fingerpoint"
}

$animation "gesturefingerpoint_right_01" "gesture_animations_anims\gesturefingerpoint_right_01.smd" {
	fps 30
	loop
	// Crowbar writes this subtract option to prevent jigglebone and poseparameter problems when delta sequences are recompiled.
	subtract "gesturefingerpoint_right_01_corrective_animation" 0
	weightlist "weights_gesture01_fingerpoint_additive"
}

$animation "gesturefingerpoint_right_run_01" "gesture_animations_anims\gesturefingerpoint_right_run_01.smd" {
	fps 30
	// Crowbar writes this subtract option to prevent jigglebone and poseparameter problems when delta sequences are recompiled.
	subtract "gesturefingerpoint_right_run_01_corrective_animation" 0
	weightlist "weights_gesture01_fingerpoint_additive"
}

$sequence "gesture01_fingerpoint_additive" {
	"gesturefingerpoint_right_01"
	"gesturefingerpoint_right_run_01"
	blend "player_movement" 148 160
	blendwidth 2
	delta
	fadein 0.2
	fadeout 0.2
	hidden
}

$sequence "gesture01_fingerpoint" {
	"gesturefingerpoint_01"
	"gesturefingerpoint_run_01"
	blend "player_movement" 148 160
	blendwidth 2
	fadein 0.2
	fadeout 0.2
	addlayer "gesture01_fingerpoint_additive"
}

