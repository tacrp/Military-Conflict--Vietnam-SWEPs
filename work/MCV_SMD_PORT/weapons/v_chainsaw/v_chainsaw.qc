$sequence "runlayer" {
	"runIdle_a"
	"run_a"
	blend "player_movement" 167 268
	blendwidth 2
	delta
	fadein 0.2
	fadeout 0.2
	hidden
	realtime
}

$sequence "walklayer" {
	"walkIdle_a"
	"walk_a"
	"walkIdle_a"
	blend "player_movement" 0 334
	blendwidth 3
	delta
	fadein 0.2
	fadeout 0.2
	hidden
	realtime
}

$sequence "chainidle" {
	"chainmovement_idle"
	delta
	fadein 0.2
	fadeout 0.2
	hidden
}

$sequence "chainattack" {
	"chainmovement_attack"
	fadein 0.2
	fadeout 0.2
	hidden
}

$sequence "idle" {
	"..\..\..\MCV_SMD_OG\weapons\v_chainsaw\v_chainsaw_anims\idle.smd"
	activity "ACT_VM_IDLE" 1
	fadein 0.2
	fadeout 0.2
	addlayer "walklayer"
	addlayer "runlayer"
	addlayer "chainidle"
	node "0"
	fps 30
	loop
}

$sequence "draw" {
	"..\..\..\MCV_SMD_OG\weapons\v_chainsaw\v_chainsaw_anims\draw.smd"
	activity "ACT_VM_DRAW" 1
	{ event 5004 1 "MCV_Weapon_Foley_Melee.Draw" }
	fadein 0
	fadeout 0.2
	addlayer "walklayer"
	addlayer "runlayer"
	node "0"
	fps 30
}

$sequence "shootloop" {
	"..\..\..\MCV_SMD_OG\weapons\v_chainsaw\v_chainsaw_anims\idle.smd"
	activity "ACT_VM_PRIMARYATTACK" 1
