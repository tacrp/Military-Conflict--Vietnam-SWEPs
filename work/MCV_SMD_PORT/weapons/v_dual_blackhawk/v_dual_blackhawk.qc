$sequence "idle" {
	"basePose_a"
	"ironsight_transition"
	"ironsight"
	activity "ACT_VM_IDLE" 1
	blend "ironsight" 0 1
	blendwidth 3
	fadein 0.2
	fadeout 0.2
	addlayer "walklayer"
	addlayer "runlayer"
	addlayer "recoil_layer_r"
	addlayer "recoil_layer_l"
}

$sequence "FirstDraw" {
	"FirstDraw_a"
	"FirstDraw_i_a"
	activity "ACT_VM_READY" 1
	blend "ironsight" 0 1
	blendwidth 2
	{ event 5004 1 "MCV_Weapon_Foley_M1895.Draw" }
	{ event 5004 10 "MCV_Weapon_Foley_Revolver.HammerOut" }
	{ event 5004 12 "MCV_Weapon_Foley_Revolver.HammerOut" }
	fadein 0
	fadeout 0.2
	node "0"
	addlayer "walklayerironsight"
}

$sequence "draw" {
	"Draw_a"
	"Draw_i_a"
	activity "ACT_VM_DRAW" 1
	blend "ironsight" 0 1
	blendwidth 2
	{ event 5004 1 "MCV_Weapon_Foley_M1895.Draw" }
	fadein 0
	fadeout 0.2
	node "0"
	addlayer "walklayerironsight"
}

$sequence "shoot_hammer_right" {
	"basePose_a__f60"
	"ironsight_transition__f60"
	"ironsight__f60"
	activity "ACT_VM_PRIMARYATTACK" 1
	blend "ironsight" 0 1
	blendwidth 3
	snap
	{ event 5004 10 "MCV_Weapon_Foley_Revolver.Hand" }
	{ event 5004 15 "MCV_Weapon_Foley_Revolver.HammerOut" }
	addlayer "walklayer"
	addlayer "runlayer"
	addlayer "shoot_hammer_right_pose"
	node "0"
}
$sequence "shoot_hammer_right_pose" {
	"shoot_r_a"
	"shoot_r_ironsight_a"
	blend "ironsight" 0 1
	blendwidth 2
	delta
	snap
	hidden
}

$sequence "shoot_hammer_left" {
	"basePose_a__f60"
	"ironsight_transition__f60"
	"ironsight__f60"
	activity "ACT_VM_SECONDARYATTACK" 1
	blend "ironsight" 0 1
	blendwidth 3
	snap
