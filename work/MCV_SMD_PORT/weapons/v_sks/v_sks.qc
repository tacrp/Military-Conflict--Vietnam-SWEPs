$sequence "idle" {
	"basePose_a"
	"ironsight_transition"
	"ironsight"
	blend "ironsight" 0 1
	blendwidth 3
	activity "ACT_VM_IDLE" 1
	fadein 0.2
	fadeout 0.2
	addlayer "walklayer"
	addlayer "runlayer"
	addlayer "SlidePosition"
	node "0"
}

$sequence "draw" {
	"..\..\..\MCV_SMD_OG\weapons\v_sks\v_sks_anims\draw.smd"
	"..\..\..\MCV_SMD_OG\weapons\v_sks\v_sks_anims\draw_2.smd"
	activity "ACT_VM_DRAW" 1
	blend "ironsight" 0 1
	blendwidth 2
	{ event 5004 1 "MCV_Weapon_Foley_SKS.Draw" }
	{ event AE_WPN_CLIP_TO_POSEPARAM 1 "ammo_fraction" }
	fadein 0
	fadeout 0.2
	addlayer "SlidePosition"
