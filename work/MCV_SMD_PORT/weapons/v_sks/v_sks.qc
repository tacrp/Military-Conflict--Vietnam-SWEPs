$sequence "SlidePosition" {
	"Default"
	"Slideback"
	blend "empty" 0.6 1
	blendwidth 2
	delta
	fadein 0.2
	fadeout 0.2
	hidden
	node "0"
}

$sequence "runlayer" {
	"runIdle_a"
	"run_a"
	blend "player_movement" 137 232
