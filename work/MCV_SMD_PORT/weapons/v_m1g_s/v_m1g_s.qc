$sequence "SlidePosition" {
	"Default"
	"Slideback"
	blend "empty" 0.6 1
	blendwidth 2
	delta
	fadein 0.2
	fadeout 0.2
	hidden
	node "0"
}

$sequence "BulletCounter" {
	"Bullet08"
	"Bullet07"
	"Bullet06"
	"Bullet05"
	"Bullet04"
	"Bullet03"
	"Bullet02"
	"Bullet01"
	"FullBullet"
	blend "ammo_fraction" 0 1
	blendwidth 9
	delta
	fadein 0.2
	fadeout 0.2
	hidden
	node "0"
}

$sequence "runlayer" {
	"runIdle_a"
	"run_a"
	blend "player_movement" 134 228
	blendwidth 2
	delta
	fadein 0.2
	fadeout 0.2
	hidden
	realtime
}

$sequence "walklayer" {
	"walkIdle_a"
	"walk_a"
	"walkIdle_a"
	"walkIdle_a"
	"walkIdle_a"
	"walkIdle_a"
	blend "player_movement" 0 276
	blend "ironsight" 0 1
	blendwidth 3
	delta
	fadein 0.2
	fadeout 0.2
	hidden
