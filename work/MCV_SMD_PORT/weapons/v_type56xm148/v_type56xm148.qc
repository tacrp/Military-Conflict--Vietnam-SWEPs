	"pickup_gren_i_a"
	activity "ACT_VM_PICKUPLOOP_GL" 1
	blend "ironsight" 0 1
	blendwidth 2
	fadein 0.2
	fadeout 0.2
	addlayer "walklayergrenironsight"
}

$sequence "holster_grenade" {
	"..\..\..\MCV_SMD_OG\weapons\v_type56xm148\v_type56xm148_anims\holster_grenade.smd"
	activity "ACT_VM_HOLSTER_GL" 1
	{ event 5004 0 "MCV_Weapon_Foley_M16A1.Holster" }
	fadein 0.2
	fadeout 0.2
	addlayer "walklayer"
	addlayer "walklayerironsight"
	addlayer "runlayer"
	fps 30
}

$includemodel "weapons/mcv/gesture_animations.mdl"

